{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "credential assigned a literal value",
            "pattern": "/\\b[A-Z][A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_KEY|PRIVATE_KEY)=(?![\"'$<\\s]|$)[^\\s\"'$]{2,}/"
          }
        ]
      }
    }
  ]
}
