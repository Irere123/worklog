# Settings for `docker compose` (compose.yaml). Copy to .env and fill in; it stays out of git.
# Every setting the API reads is described in apps/api/.env.example.

# --- Required ---
# The database's password: openssl rand -hex 24
POSTGRES_PASSWORD=
# Encrypts connection secrets at rest: openssl rand -hex 32. Keep it safe: lost, the
# connections it sealed have to be set up again.
WORKLOG_SECRET_KEY=
# Signs sessions: openssl rand -hex 32
AUTH_SECRET=
# Where people reach Worklog. Sign-in links, OAuth callbacks and links in briefs start with it.
PUBLIC_URL=https://worklog.example.com

# --- HTTPS (with compose.https.yaml) ---
# The host name in PUBLIC_URL, with its DNS pointing at this server; the web server gets the
# certificate and renews it.
WORKLOG_DOMAIN=worklog.example.com

# --- Images ---
# The published tag to run: latest, a version (1.2.0) or a commit (sha-9fceb02). Or build this
# checkout with `docker compose up -d --build`.
# WORKLOG_VERSION=latest
# The version you deploy, reported in health checks and telemetry (a git sha or tag), when building.
# WORKLOG_RELEASE=

# --- Where the web server listens on this machine, without compose.https.yaml ---
# Point your own proxy here.
# WORKLOG_BIND=127.0.0.1
# WORKLOG_PORT=8080

# --- Backups ---
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_EVERY_SECONDS=86400

# --- Optional: AI, email, sign-in providers, connected apps, telemetry ---
# OPENROUTER_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM="Worklog <worklog@example.com>"
# TINYBIRD_TOKEN=
# The GitHub App: `bun run github-app --url <PUBLIC_URL>` writes all six (docs/DEPLOY.md)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
