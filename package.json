{
  "name": "worklog",
  "private": true,
  "description": "Worklog: see what your team (humans and agents) is working on, what needs your attention, and ask anyone's agent about their work.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @worklog/api dev",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "format": "bun --bun oxfmt",
    "format:check": "bun --bun oxfmt --check",
    "sdk": "bun run --filter @worklog/sdk generate"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "ultracite": "8.1.0"
  }
}
