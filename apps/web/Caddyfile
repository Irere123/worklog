# The web app's server: the built app from /srv, and the API's paths passed through to it, so
# the browser sees one origin and the session cookie and event streams need no CORS.
#
# SITE_ADDRESS  `:8080` (the default) serves plain HTTP behind a platform or proxy that holds
#               TLS (Railway does). A host name (`worklog.example.com`) makes Caddy get a
#               certificate and serve HTTPS on 443 itself.
# API_UPSTREAM  Where the API listens (default `api:4000`).
{
	admin off
	servers {
		# Railway's edge or your proxy sits in front, on a private address. Trusting what it
		# forwards lets the API see who's calling, for rate limits and sign-in records.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::8080} {
	@api path /v1/* /api/* /hooks/* /oauth/* /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:4000} {
			# Event streams and the assistant's replies reach the browser as they're written.
			flush_interval -1
		}
	}

	# What Railway's deploy check asks, on the site itself.
	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			-Server
		}

		# Built files carry a content hash in their names, so a cached copy is never stale. The
		# shell names this build's files, so it's never served from a cache.
		@hashed path /assets/*
		@app not path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @app Cache-Control no-cache

		# One missing is a tab on an older build asking for its chunks: a 404 lets it fail cleanly,
		# where the shell would arrive as a script and break with a MIME error.
		handle @hashed {
			file_server {
				precompressed br gzip
			}
		}

		# A page the build prerendered (the front page) is its folder's index.html. Any other path
		# that isn't a file is a route the app handles in the browser.
		handle {
			try_files {path} {path}/index.html /_shell.html
			file_server {
				precompressed br gzip
			}
		}
	}
}

# The container's health check, on its own port, so it answers whatever SITE_ADDRESS is.
:8081 {
	respond /health "ok" 200
}
