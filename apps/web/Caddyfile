# The web app's server: the built app from /srv, and everything else passed through to the API, so
# the browser sees one origin and the session cookie and event streams need no CORS.
#
# SITE_ADDRESS  `:8080` (the default) serves plain HTTP behind a platform or proxy that holds
#               TLS (Railway does). A host name (`worklog.example.com`) makes Caddy get a
#               certificate and serve HTTPS on 443 itself.
# API_UPSTREAM  Where the API listens (default `api:4000`).
{
	admin off
	servers {
		# Railway's edge or your proxy sits in front, on a private address. Trusting what it
		# forwards lets the API see who's calling, for rate limits and sign-in records.
		trusted_proxies static private_ranges
	}
}

(app_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

(app_files) {
	root * /srv
	import app_headers
	file_server {
		precompressed br gzip
	}
}

{$SITE_ADDRESS::8080} {
	# What Railway's deploy check asks, on the site itself.
	handle /health {
		respond "ok" 200
	}

	# Built files carry a content hash in their names, so a cached copy is never stale. One missing
	# is a tab on an older build asking for its chunks: a 404 lets it fail cleanly, where the shell
	# would arrive as a script and break with a MIME error.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		import app_files
	}

	# A file the build made, or a page it prerendered (the front page is its folder's index.html).
	# These name this build's assets, so they're never served from a cache.
	@built file {
		root /srv
		try_files {path} {path}/index.html
	}
	handle @built {
		header Cache-Control no-cache
		rewrite * {file_match.relative}
		import app_files
	}

	# Everything else is the API's to answer, so no list here has to keep up with its routes: a new
	# endpoint, or a path a standard fixes like /.well-known, works through this server as it is.
	# A browser page the API has no route for comes back marked, and gets the app's shell, which
	# routes in the browser.
	handle {
		reverse_proxy {$API_UPSTREAM:api:4000} {
			# Event streams and the assistant's replies reach the browser as they're written.
			flush_interval -1

			@shell {
				status 404
				header Worklog-Shell 1
			}
			handle_response @shell {
				header Cache-Control no-cache
				rewrite * /_shell.html
				import app_files
			}
		}
	}
}

# The container's health check, on its own port, so it answers whatever SITE_ADDRESS is.
:8081 {
	respond /health "ok" 200
}
