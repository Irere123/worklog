# --- Server ---
PORT=4000
# Where the API and the worker listen: "::" for IPv6 too (Railway's private network needs it)
HOST=0.0.0.0
# The worker's health check (GET /health), apart from PORT so it can run beside the API
WORKER_PORT=4001
PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/worklog
# Tests drop and recreate this database on every run
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/worklog_test
# 32 bytes, hex or base64 (required in production): openssl rand -hex 32
WORKLOG_SECRET_KEY=
# After rotating the key: the keys it replaced, comma-separated, until `bun run secrets:reseal` has run
WORKLOG_SECRET_KEYS_PREVIOUS=
# Lets POST /v1/setup create more workspaces after the first one
SETUP_SECRET=
# open: anyone who signs in may start a workspace. closed: people join only by invite
SIGNUP=open
# Days to keep raw webhook deliveries; replay can't reach further back. 0 keeps them all
INBOUND_RETENTION_DAYS=90
# History a new connection reads from the provider's API, and how recent read-back history must be to still notify
BACKFILL_DAYS=14
BACKFILL_NOTIFY_HOURS=48
# Jobs per process, and database connections per process (keep the pool above the concurrency)
WORKER_CONCURRENCY=8
DATABASE_POOL_SIZE=20
# Run background jobs (ingestion, automations, entropy) in this process; set false and run `bun run worker` separately to split
RUN_SCHEDULER=true

# --- Sign-in (better-auth) ---
# Required in production: openssl rand -hex 32
AUTH_SECRET=
# Web app origins allowed to use cookie sessions (comma-separated)
WEB_ORIGINS=http://localhost:3000
# Serve the built web app from this server (after `bun run build` in apps/web), e.g. ../web/dist/client
WEB_DIST=
# Social sign-in: set any of these to enable the provider (callback: $PUBLIC_URL/api/auth/callback/<provider>)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Apps workspaces install with one click (or create them from the API: see docs/CONNECTORS.md) ---
# GitHub App: the client id and secret above are this app's. Private key: PEM, \n for line breaks
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Slack app: the client id and secret above are this app's
SLACK_APP_ID=
SLACK_SIGNING_SECRET=
# Discord app: the client id and secret above are this app's; its interactions URL is /hooks/apps/discord/interactions
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# --- AI (optional; without it Worklog uses deterministic fallbacks) ---
OPENROUTER_API_KEY=
WORKLOG_MODEL=anthropic/claude-opus-5.5
WORKLOG_FAST_MODEL=anthropic/claude-haiku-5.5
WORKLOG_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# --- Email (Resend if set, else SMTP if set, else printed to the console) ---
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM="Worklog <worklog@localhost>"

# --- Telemetry (optional; without a token, logs only reach the console) ---
# Tinybird token with append rights on spans, logs and metrics (`tb token copy worklog_append`)
TINYBIRD_TOKEN=
# Your Tinybird workspace's region
TINYBIRD_HOST=https://api.tinybird.co
# Share of traces kept; traces with an error or slower than TELEMETRY_SLOW_MS are always kept
TELEMETRY_SAMPLE_RATE=1
TELEMETRY_SLOW_MS=2000
# The deploy running (a git sha or tag), to tell which release an error started in
WORKLOG_RELEASE=
