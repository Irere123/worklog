# --- Server ---
PORT=4000
PUBLIC_URL=http://localhost:4000
# postgres://user:pass@host:5432/worklog for a real Postgres; a path = embedded PGlite; memory:// = in-memory
DATABASE_URL=./.data/pglite
# 32 bytes, hex or base64 (required in production): openssl rand -hex 32
WORKLOG_SECRET_KEY=
# Lets POST /v1/setup create more workspaces after the first one
SETUP_SECRET=
# Run automations/entropy in this process (set false and run `bun run worker` separately to split)
RUN_SCHEDULER=true

# --- Sign-in (better-auth) ---
# Required in production: openssl rand -hex 32
AUTH_SECRET=
# Web app origins allowed to use cookie sessions (comma-separated)
WEB_ORIGINS=http://localhost:3000
# Social sign-in: set any of these to enable the provider (callback: $PUBLIC_URL/api/auth/callback/<provider>)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- AI (optional; without it Worklog uses deterministic fallbacks) ---
OPENROUTER_API_KEY=
WORKLOG_MODEL=anthropic/claude-opus-5.5
WORKLOG_FAST_MODEL=anthropic/claude-haiku-5.5

# --- Email (Resend if set, else SMTP if set, else printed to the console) ---
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM="Worklog <worklog@localhost>"
