{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "scripts", "drizzle.config.ts"]
}
